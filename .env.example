# ---------------------------------------------------------------------------
# Smartisan Blog 环境变量示例
# 复制为 .env.local 后填入真实值；.env.local 已被 .gitignore 忽略
# ---------------------------------------------------------------------------

# 站点对外地址：用于拼接 OAuth 回调地址与生成绝对链接，本地调试可留空自动推断
SITE_URL=https://your-domain.example.com

# ---------------------------------------------------------------------------
# GitHub OAuth 登录（仅用于确认「你是谁」，不参与文章读写）
# 创建入口：GitHub → Settings → Developer settings → OAuth Apps
# 回调地址填写：${SITE_URL}/api/auth/github/callback
# ---------------------------------------------------------------------------
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret

# 会话 Cookie 的 HMAC 签名密钥，生成方式：openssl rand -hex 32
AUTH_SECRET=replace_with_openssl_rand_hex_32

# 站长白名单：拥有后台编辑权限的 GitHub 用户名，多个用英文逗号分隔（不区分大小写）
ADMIN_GITHUB_LOGINS=your-github-username

# ---------------------------------------------------------------------------
# 内容仓库（推荐独立私有仓，代码仓不必包含任何文章）
# BLOG_GITHUB_TOKEN 建议使用 fine-grained PAT，且只授权这一个内容仓的
# Contents: Read and write 权限；不要勾选其它仓库或组织级权限。
# 未配置 BLOG_REPO / BLOG_GITHUB_TOKEN 时，站点回退读取本地 src/content 示例内容。
# ---------------------------------------------------------------------------
BLOG_REPO=your-name/your-private-content-repo
BLOG_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
BLOG_BRANCH=main

# 内容子目录：与内容仓内的实际目录保持一致
# 注意：路径会直接拼进 GitHub API URL（未做编码），不要包含空格或特殊字符
BLOG_POSTS_DIR=src/content/posts
BLOG_NOTES_DIR=src/content/notes

# ---------------------------------------------------------------------------
# Keystatic 后台（可选）
# 只有把 keystatic.config.ts 切换到 github 存储模式时才需要；
# 值为已安装到内容仓库的 Keystatic GitHub App 的 slug。
# 该变量会被打包进客户端，必须使用 NEXT_PUBLIC_ 前缀。
# ---------------------------------------------------------------------------
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=your-keystatic-github-app-slug

# ---------------------------------------------------------------------------
# 多媒体存储：Cloudflare R2（S3 兼容 API）
# 只用于图片/附件上传，与内容仓库无关；建议为 R2 单独创建一枚最小权限密钥。
# 公开访问域名示例：https://media.your-domain.example.com
#
# 上传采用「服务端签发预签名 PUT + 浏览器直连 R2」，因此桶必须配置 CORS：
# Allowed Origins = 站点域名（本地调试加 http://localhost:3000）
# Allowed Methods = PUT
# Allowed Headers = Content-Type
# 未配置 CORS 时前端会提示「浏览器直连 R2 失败」。
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your-bucket-name
R2_PUBLIC_BASE_URL=https://media.your-domain.example.com

# ---------------------------------------------------------------------------
# 首页天气模块（Open-Meteo，无需 Key）
# 默认按浏览器定位取数（坐标经 /api/weather 服务端缓存 15 分钟，不落盘不记日志）；
# 下面三项只配置「定位失败时的兜底城市」，留空则用 src/lib/site.ts 的默认城市（深圳）。
# WEATHER_CITY 仅用于展示，实际取数位置由经纬度决定；兜底也失败时卡片降级为「天气暂不可用」。
# 城市名反查由浏览器直连 BigDataCloud 的免费客户端接口，无 Key。
# ---------------------------------------------------------------------------------
WEATHER_CITY=
WEATHER_LATITUDE=
WEATHER_LONGITUDE=

# ---------------------------------------------------------------------------
# AI 供应商配置存储：Cloudflare KV（REST API）
# 工坊「AI 设置」页会把多家供应商的 Key 加密后写入单条 KV 记录 ai-config:v1。
# 账号 ID 复用上面的 R2_ACCOUNT_ID；加密主密钥由 AUTH_SECRET 经 HKDF 派生，
# 因此不需要额外配置密钥变量。
# CF_API_TOKEN 建议使用只具备「Account → Workers KV Storage → Edit」权限的令牌。
# 未配置这两个变量时，工坊的 AI 设置入口会被隐藏（本地开发会回退到
# .ai-config.local.json 临时文件，该文件已被 .gitignore 忽略）。
# ---------------------------------------------------------------------------
CF_KV_NAMESPACE_ID=your_kv_namespace_id
CF_API_TOKEN=your_cloudflare_kv_api_token
